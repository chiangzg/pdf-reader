# =========================================================
#  PDF 翻译阅读器 —— 环境变量模板
#  使用方法：cp .env.example .env，然后填入真实值
# =========================================================

# ---- 域名（部署到服务器时改为你自己的域名）----
DOMAIN=localhost

# ---- Traefik（HTTPS 自动证书）----
# ACME 邮箱（用于 Let's Encrypt 证书申请通知）
ACME_EMAIL=admin@example.com
# 是否开启 ACME 生产环境证书签发；本地开发设 false 用自签/无证书
ACME_CA_SERVER=staging

# ---- PostgreSQL ----
POSTGRES_USER=pdfreader
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=pdfreader
# 仅容器内部使用，不需要改
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- pdf2zh 翻译服务 ----
# 容器内部地址，compose 中 pdf2zh 服务名；通常无需修改
PDF2ZH_URL=http://pdf2zh:7860

# ---- 后端 ----
# 运行环境：development / production
APP_ENV=production
# JWT 签名密钥（请用 `openssl rand -hex 32` 生成）
SECRET_KEY=change-me-please-use-openssl-rand-hex-32
# Cookie 域名（留空则使用 DOMAIN；生产部署填你的域名）
COOKIE_DOMAIN=
# 跨域允许来源（逗号分隔；生产填 https://你的域名）
CORS_ORIGINS=http://localhost

# ---- DeepSeek API（翻译引擎 + AI 解读）----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 上传限制 ----
MAX_UPLOAD_MB=50
